# Copy to .env for local overrides. On Railway, set these in the service
# Variables tab. Do not commit a filled-in .env.

# Brevo transactional email API key (Brevo: SMTP & API → API keys).
# Railway blocks outbound SMTP, so activation and notification mail is
# sent with an HTTP POST to https://api.brevo.com/v3/smtp/email.
# If this is empty, mail is printed to the console and sign-up still succeeds.
BREVO_API_KEY=

# From address. mathkg.com is authenticated in Brevo (DKIM + DMARC).
# Defaults to MathKG <no-reply@mathkg.com>. Set either the address or the
# whole header; DEFAULT_FROM_EMAIL wins when both are set.
# BREVO_SENDER_EMAIL=no-reply@mathkg.com
# BREVO_SENDER_NAME=MathKG
# DEFAULT_FROM_EMAIL=MathKG <no-reply@mathkg.com>

# Replies land here. no-reply@mathkg.com has no mailbox. Defaults to the
# admin notification inbox (mathematicskgz@gmail.com).
# DEFAULT_REPLY_TO_EMAIL=mathematicskgz@gmail.com
# ADMIN_NOTIFICATION_EMAIL=mathematicskgz@gmail.com

# Canonical origin. Defaults to https://mathkg.com when unset. Used for
# canonical/og tags, sitemap.xml, robots.txt, and links in email.
# SITE_URL=https://mathkg.com

# Optional extra hosts. Production already allows mathkg.com,
# www.mathkg.com, and mathkg-production.up.railway.app.
# EXTRA_ALLOWED_HOSTS is a hostname with no scheme.
# EXTRA_CSRF_TRUSTED_ORIGINS needs https://.
# EXTRA_ALLOWED_HOSTS=
# EXTRA_CSRF_TRUSTED_ORIGINS=
